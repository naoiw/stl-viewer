{
  "name": "stl-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:pages:main": "tsc --noEmit && vite build --base=/stl-viewer/",
    "build:pages:develop": "tsc --noEmit && vite build --base=/stl-viewer/develop/",
    "predev": "node scripts/generate-samples-index.mjs",
    "prebuild": "node scripts/generate-samples-index.mjs",
    "prebuild:pages:main": "node scripts/generate-samples-index.mjs",
    "prebuild:pages:develop": "node scripts/generate-samples-index.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.8.3",
    "vite": "7.1.9"
  }
}
